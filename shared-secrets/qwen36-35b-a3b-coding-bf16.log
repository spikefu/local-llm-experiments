  540 function exportPublicKeyJWK() {
  541   if (!keyPair) return showToast('Generate keys first');
  542   crypto.subtle.exportKey('jwk', keyPair.publicKey).then(jwk => {
  543     const blob = new Blob([JSON.stringify(jwk, null, 2)], { type: 'applicat
      ion/json' });
  544     const url = URL.createObjectURL(blob);
  545     const a = document.createElement('a');
  546     a.href = url; a.download = 'public-key.json'; a.click();
  547     URL.revokeObjectURL(url);
  548   });
  549 }
