  551 function exportPrivateKeyJWK() {
  552   if (!keyPair) return showToast('Generate keys first');
  553   crypto.subtle.exportKey('jwk', keyPair.privateKey).then(jwk => {
  554     // Add IAT for added security metadata
  555     Object.assign(jwk, { iat: Date.now() });
  556     const blob = new Blob([JSON.stringify(jwk, null, 2)], { type: 'applicat
      ion/json' });
  557     const url = URL.createObjectURL(blob);
  558     const a = document.createElement('a');
  559     a.href = url; a.download = 'private-key.json'; a.click();
  560     URL.revokeObjectURL(url);
  561   });
  562 }
