  525 // ── Public Key Format Toggle ──
  526 function setPubFormat(fmt) {
  527   currentPubFormat = fmt;
  528   document.getElementById('formatPEM').classList.toggle('active', fmt === '
      pem');
  529   document.getElementById('formatJWK').classList.toggle('active', fmt === '
      jwk');
  530
  531   const el = document.getElementById('pubKeyPEM');
  532   if (!keyPair) return;
  533
  534   crypto.subtle.exportKey(fmt === 'jwk' ? 'jwk' : 'spki', keyPair.publicKey
      )
  535     .then(result => {
  536       el.value = fmt === 'jwk' ? JSON.stringify(result, null, 2) : encodePE
      M(new Uint8Array(result), 'PUBLIC KEY');
  537     });
  538 }
