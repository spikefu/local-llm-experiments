  564 // ── Hybrid Encryption ──
  565 // AES-GCM is used to encrypt the message, RSA-OAEP encrypts the AES key
  566 async function encryptMessage(pubKeyPEM, plaintext) {
  567   const pubKey = await importPublicKey(pubKeyPEM);
  568
  569   // Generate random AES-256 key
  570   const aesKey = await crypto.subtle.generateKey(
  571     { name: 'AES-GCM', length: 256 },
  572     true,
  573     ['encrypt']
  574   );
  575
  576   // Encrypt AES key with RSA-OAEP
  577   const aesKeyWrapped = await crypto.subtle.exportKey('raw', aesKey);
  578   const encryptedKey = await crypto.subtle.encrypt(
  579     { name: 'RSA-OAEP' },
  580     pubKey,
  581     aesKeyWrapped
  582   );
  583
  584   // Generate IV
  585   const iv = crypto.getRandomValues(new Uint8Array(12));
  586
  587   // Encrypt message with AES-GCM
  588   const plaintextBytes = new TextEncoder().encode(plaintext);
  589   const encryptedData = await crypto.subtle.encrypt(
  590     { name: 'AES-GCM', iv },
  591     aesKey,
  592     plaintextBytes
  593   );
  594
  595   // Pack: {"RSA-OAEP-256","A256GCM", encryptedKey, iv, encryptedData}
  596   const payload = {
  597     alg: 'RSA-OAEP-256',
  598     enc: 'A256GCM',
  599     key: byteToB64(new Uint8Array(encryptedKey)),
  600     iv: byteToB64(iv),
  601     data: byteToB64(new Uint8Array(encryptedData))
  602   };
  603
  604   return JSON.stringify(payload);
  605 }
  606
  607 async function doEncrypt() {
  608   const errEl = document.getElementById('encryptError');
  609   errEl.textContent = '';
  610
  611   const pubKeyStr = document.getElementById('pubKeyInput').value.trim();
  612   const plain = document.getElementById('plaintextInput').value;
  613
  614   if (!pubKeyStr) { errEl.textContent = 'Please paste the receiver\'s publi
      c key.'; return; }
  615   if (!plain) { errEl.textContent = 'Please enter a message to encrypt.'; r
      eturn; }
  616
  617   try {
  618     const ciphertext = await encryptMessage(pubKeyStr, plain);
  619     document.getElementById('ciphertextOutput').textContent = ciphertext;
  620   } catch (e) {
  621     errEl.textContent = 'Encryption failed: ' + e.message;
  622   }
  623 }
