  625 // ── Hybrid Decryption ──
  626 async function decryptMessage(privKeyPEM, ciphertextJSON) {
  627   const payload = JSON.parse(ciphertextJSON);
  628
  629   if (payload.alg !== 'RSA-OAEP-256') throw new Error('Unsupported algorith
      m: ' + payload.alg);
  630   if (payload.enc !== 'A256GCM') throw new Error('Unsupported encryption: '
       + payload.enc);
  631
  632   const privKey = await importPrivateKey(privKeyPEM);
  633
  634   // Decrypt AES key with RSA-OAEP
  635   const encryptedKey = b64toBytes(payload.key);
  636   const aesKeyRaw = await crypto.subtle.decrypt(
  637     { name: 'RSA-OAEP' },
  638     privKey,
  639     encryptedKey
  640   );
  641
  642   // Import AES key
  643   const aesKey = await crypto.subtle.importKey(
  644     'raw', aesKeyRaw,
  645     { name: 'AES-GCM', length: 256 },
  646     true,
  647     ['decrypt']
  648   );
  649
  650   // Decrypt message
  651   const iv = b64toBytes(payload.iv);
  652   const encryptedData = b64toBytes(payload.data);
  653
  654   const decryptedBytes = await crypto.subtle.decrypt(
  655     { name: 'AES-GCM', iv },
  656     aesKey,
  657     encryptedData
  658   );
  659
  660   return new TextDecoder().decode(decryptedBytes);
  661 }
