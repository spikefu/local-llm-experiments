  366 <script>
  367 // ── State ──
  368 let currentPubFormat = 'pem';
  369 let keyPair = null; // stores last generated CryptoKeyPair
  370
  371 // ── Utility ──
  372 function showToast(msg) {
  373   const t = document.getElementById('toast');
  374   t.textContent = msg;
  375   t.classList.add('show');
  376   setTimeout(() => t.classList.remove('show'), 1500);
  377 }
  378
  379 function copyToClipboard(id) {
  380   const el = document.getElementById(id);
  381   navigator.clipboard.writeText(el.value || el.textContent).then(() => show
      Toast('Copied!'));
  382 }
  383
  384 function copyToClipboardText(id) {
  385   const el = document.getElementById(id);
  386   navigator.clipboard.writeText(el.textContent).then(() => showToast('Copie
      d!'));
  387 }
  388
  389 function downloadBlob(id, filename) {
  390   const text = document.getElementById(id).textContent;
  391   if (!text.trim()) return;
  392   const blob = new Blob([text], { type: 'application/octet-stream' });
  393   const url = URL.createObjectURL(blob);
  394   const a = document.createElement('a');
  395   a.href = url; a.download = filename; a.click();
  396   URL.revokeObjectURL(url);
  397 }
  398
  399 // ── PEM helpers ──
  400 function b64toBytes(b64) {
  401   return Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  402 }
  403
  404 function byteToB64(bytes) {
  405   const chunk = 64;
  406   const total = bytes.length;
  407   let out = '';
  408   for (let i = 0; i < total; i += chunk) {
  409     const slice = bytes.slice(i, Math.min(i + chunk, total));
  410     let bin = '';
  411     for (const b of slice) bin += String.fromCharCode(b);
  412     out += btoa(bin);
  413   }
  414   return out;
  415 }
  416
  417 function encodePEM(bytes, label) {
  418   return '-----BEGIN ' + label + '-----\n' + byteToB64(bytes).match(/.{1,64
      }/g).join('\n') + '\n-----END ' + label + '-----';
  419 }
  420
  421 function decodePEM(pem) {
  422   const lines = pem.trim().split('\n').filter(l => !l.startsWith('-----') &
      & l.trim());
  423   const b64 = lines.join('');
  424   return b64toBytes(b64);
  425 }
  426
  427 function pemToBuffer(pem) { return decodePEM(pem); }
  428
  429 // ── Key import / export ──
  430 async function importPublicKey(pemStr) {
  431   const der = pemToBuffer(pemStr);
  432   return await crypto.subtle.importKey('spki', der, { name: 'RSA-OAEP', has
      h: 'SHA-256' }, true, ['encrypt']);
  433 }
  434
  435 async function importPrivateKey(pemStr) {
  436   // PKCS#8
  437   try {
  438     const der = pemToBuffer(pemStr);
  439     return await crypto.subtle.importKey('pkcs8', der, { name: 'RSA-OAEP',
      hash: 'SHA-256' }, true, ['decrypt']);
  440   } catch {
  441     // Try PKCS#1 (RSA PRIVATE KEY wrapper)
  442     try {
  443       const der = pemToBuffer(pemStr);
  444       return await parsePKCS1(der);
  445     } catch {
  446       throw new Error('Unrecognized private key format. Expected PKCS#8 or
      PKCS#1 PEM.');
  447     }
  448   }
  449 }
  450
  451 // Minimal PKCS#1 RSA PRIVATE KEY → PKCS#8 der (bytes)
  452 // We do it via manual DER parsing since browsers don't expose raw RSA priv
      ate key import
  453 async function parsePKCS1(derBytes) {
  454   // PKCS#1 structure: SEQUENCE { version, modulus, publicExponent, private
      Exponent, ... }
  455   // We wrap it in PKCS#8 for import
  456   // PKCS#1: SEQUENCE { INTEGER(0), OCTET STRING (modulus), INTEGER (e), IN
      TEGER (d), ... }
  457   // PKCS#8: SEQUENCE { INTEGER(0), SEQUENCE {OID rsaEncryption, NULL}, OCT
      ET STRING (PKCS#1) }
  458
  459   // Simple approach: wrap the entire PKCS#1 DER in a PKCS#8 envelope
  460   const rsaOid = new Uint8Array([0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7,
      0x0D, 0x01, 0x01, 0x01]);
  461   const nullByte = new Uint8Array([0x05, 0x00]);
  462
  463   // Encode the PKCS#1 data as an OCTET STRING
  464   const inner = wrapTLV(0x04, derBytes); // OCTET STRING
  465
  466   // Wrap with algorithm identifier
  467   const content = concatBytes(rsaOid, nullByte, inner);
  468   const wrapped = wrapTLV(0x30, content); // SEQUENCE
  469
  470   // Version = INTEGER 0
  471   const version = new Uint8Array([0x02, 0x01, 0x00]);
  472
  473   // PKCS#8 = SEQUENCE { version, SEQUENCE {OID, NULL}, OCTET_STRING {PKCS1
      } }
  474   const pkcs8 = concatBytes(version, wrapped, wrapTLV(0x04, derBytes));
  475
  476   // Re-wrap as top-level SEQUENCE
  477   const final = wrapTLV(0x30, pkcs8);
  478
  479   return await crypto.subtle.importKey('pkcs8', final, { name: 'RSA-OAEP',
      hash: 'SHA-256' }, true, ['decrypt']);
  480 }
  481
  482 function wrapTLV(tag, value) {
  483   const len = value.length;
  484   if (len < 128) return concatBytes(new Uint8Array([tag, len]), value);
  485   if (len < 256) return concatBytes(new Uint8Array([tag, 0x81, len]), value
      );
  486   return concatBytes(new Uint8Array([tag, 0x82, (len >> 8) & 0xFF, len & 0x
      FF]), value);
  487 }
  488
  489 function concatBytes(...arrays) {
  490   const total = arrays.reduce((s, a) => s + a.length, 0);
  491   const out = new Uint8Array(total);
  492   let offset = 0;
  493   for (const a of arrays) { out.set(a, offset); offset += a.length; }
  494   return out;
  495 }
  496
  497 // ── Key Generation ──
  498 async function generateKeys() {
  499   const size = parseInt(document.getElementById('keySize').value, 10);
  500   const btn = document.getElementById('genBtn');
  501   btn.textContent = 'Generating…';
  502   btn.disabled = true;
  503
  504   try {
  505     keyPair = await crypto.subtle.generateKey(
  506       { name: 'RSA-OAEP', modulusLength: size, publicExponent: new Uint8Arr
      ay([1, 0, 1]), hash: 'SHA-256' },
  507       true,
  508       ['encrypt']
  509     );
  510
  511     const pubDer = await crypto.subtle.exportKey('spki', keyPair.publicKey)
      ;
  512     const privDer = await crypto.subtle.exportKey('pkcs8', keyPair.privateK
      ey);
  513
  514     document.getElementById('pubKeyPEM').value = encodePEM(new Uint8Array(p
      ubDer), 'PUBLIC KEY');
  515     document.getElementById('privKeyPEM').value = encodePEM(new Uint8Array(
      privDer), 'PRIVATE KEY');
  516     document.getElementById('privKeyInfo').textContent = `RSA-${size} · gen
      erated ${new Date().toISOString()}`;
  517   } catch (e) {
  518     alert('Key generation failed: ' + e.message);
  519   } finally {
