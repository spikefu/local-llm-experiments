   50 /* Utility functions */
   51 function arrayBufferToBase64(buf) {
   52   const bytes = new Uint8Array(buf);
   53   let binary = '';
   54   for (let i = 0; i < bytes.byteLength; i++) {
   55     binary += String.fromCharCode(bytes[i]);
   56   }
   57   return btoa(binary);
   58 }
   59 function base64ToArrayBuffer(b64) {
   60   const binary = atob(b64);
   61   const len = binary.length;
   62   const bytes = new Uint8Array(len);
   63   for (let i = 0; i < len; i++) {
   64     bytes[i] = binary.charCodeAt(i);
   65   }
   66   return bytes.buffer;
   67 }
   68 function formatPem(pemType, b64) {
   69   const lineLength = 64;
   70   const lines = [];
   71   for (let i = 0; i < b64.length; i += lineLength) {
   72     lines.push(b64.slice(i, i + lineLength));
   73   }
   74   return `-----BEGIN ${pemType}-----\n${lines.join('\n')}\n-----END ${pemTy
      pe}-----`;
   75 }
   76 function stripPem(pem) {
   77   return pem.replace(/-----BEGIN [A-Z ]+-----/, '')
   78             .replace(/-----END [A-Z ]+-----/, '')
   79             .replace(/\s/g, '');
   80 }
